{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/stock-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "RabbitMq": {
    "Hote": "localhost",
    "Port": 5672,
    "Utilisateur": "guest",
    "MotDePasse": "guest",
    "Exchange": "commande.events",
    "ExchangePublication": "stock.events",
    "File": "stock.commande"
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "StockDb": "Server=MED\\SQLMED;Database=StockDb;Trusted_Connection=True;TrustServerCertificate=True"
  }
}
