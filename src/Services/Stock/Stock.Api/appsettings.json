{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Enrichers.Span" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:HH:mm:ss} [{Level:u3}] [{TraceId}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/stock-.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{TraceId}] {Message:lj}{NewLine}{Exception}",
          "retainedFileCountLimit": 7
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithSpan" ]
  },
  "RabbitMq": {
    "Hote": "localhost",
    "Port": 5672,
    "Utilisateur": "guest",
    "MotDePasse": "guest",
    "Exchange": "commande.events",
    "ExchangePublication": "stock.events",
    "File": "stock.commande"
  },
  "OpenTelemetry": {
    "Otlp": { "Endpoint": "http://localhost:4317" },
    "Console": false
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "StockDb": "Server=MED\\SQLMED;Database=StockDb;Trusted_Connection=True;TrustServerCertificate=True"
  }
}
